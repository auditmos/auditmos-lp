{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auditmos-lp",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Serve `/about` (200) and 307 `/about/` to it. The default
		// "auto-trailing-slash" does the opposite for directory-format output,
		// which contradicts the canonical URL, og:url, sitemap, and every
		// internal href — all slash-free.
		"html_handling": "drop-trailing-slash"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"CLOUDFLARE_ENV": "dev"
	},
	"env": {
		"dev": {
			"name": "auditmos-lp-dev",
			"vars": {
				"CLOUDFLARE_ENV": "dev"
			}
		},
		"staging": {
			"name": "auditmos-lp-staging",
			"routes": [{ "pattern": "staging.auditmos.com", "custom_domain": true }],
			"vars": {
				"CLOUDFLARE_ENV": "staging"
			}
		},
		"production": {
			"name": "auditmos-lp-production",
			"routes": [{ "pattern": "auditmos.com", "custom_domain": true }],
			"vars": {
				"CLOUDFLARE_ENV": "production"
			}
		}
	}
	// Uncomment to enable scheduled jobs:
	// "triggers": { "crons": ["0 * * * *"] },
	// Uncomment to bind a KV namespace:
	// "kv_namespaces": [{ "binding": "CACHE", "id": "" }],
	// Uncomment to bind a queue:
	// "queues": { "producers": [{ "binding": "QUEUE", "queue": "my-queue" }] }
}
