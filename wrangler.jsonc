{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auditmos-lp",
	// Wraps `@astrojs/cloudflare/entrypoints/server` — see src/worker.ts.
	"main": "./src/worker.ts",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Serve `/about` (200) and 307 `/about/` to it. The default
		// "auto-trailing-slash" does the opposite for directory-format output,
		// which contradicts the canonical URL, og:url, sitemap, and every
		// internal href — all slash-free.
		"html_handling": "drop-trailing-slash",
		// Every prerendered page route, so the Worker gets to inspect `Accept`
		// before the asset server answers — that is the only hook for
		// `Accept: text/markdown` negotiation (src/site/markdown-negotiation.ts).
		// The page still comes from the same static asset; the Worker adds one
		// hop, not a render. A new page must be added here too — a build-output
		// test asserts this list covers Astro's prerendered page routes.
		//
		// **Both URL forms, and that is not redundant.** These patterns match the
		// path literally, so `/about` does not claim `/about/`. Left out, the
		// slash form is answered by `html_handling` above with a 307, and the 301
		// in `canonicalRedirect()` never runs — only a permanent redirect
		// consolidates ranking signals onto the canonical URL. `/work` needs no
		// `/work/` because the `/work/*` wildcard already spans both, which is
		// why project pages were the only ones behaving correctly. Issue #38.
		"run_worker_first": [
			"/",
			"/about",
			"/about/",
			"/contact",
			"/contact/",
			"/open-source",
			"/open-source/",
			"/partners",
			"/partners/",
			"/privacy",
			"/privacy/",
			"/r-and-d",
			"/r-and-d/",
			"/security-audits",
			"/security-audits/",
			"/software-development",
			"/software-development/",
			"/work",
			"/work/*"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Rate limits for the two unauthenticated endpoints: MCP, and the CSP
	// violation sink. Bindings are not inherited by named environments, so these
	// are repeated in each `env` block — verify they survive into
	// dist/server/wrangler.json after changing them. `period` accepts only 10
	// or 60. `CSP_REPORT_RATE_LIMITER` must match `CSP_REPORT_RATE_LIMIT` in
	// src/csp/report-handler.ts, and `RESEND_WEBHOOK_RATE_LIMITER` must match
	// `RESEND_WEBHOOK_RATE_LIMIT` in src/resend/webhook-handler.ts; nothing can
	// catch those pairs drifting apart.
	"ratelimits": [
		{
			"name": "MCP_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			"name": "MCP_RATE_LIMITER_AUTH",
			"namespace_id": "1002",
			"simple": { "limit": 600, "period": 60 }
		},
		{
			"name": "CSP_REPORT_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "RESEND_WEBHOOK_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"vars": {
		"CLOUDFLARE_ENV": "dev"
	},
	"env": {
		"dev": {
			"name": "auditmos-lp-dev",
			"ratelimits": [
				{
					"name": "MCP_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 120, "period": 60 }
				},
				{
					"name": "MCP_RATE_LIMITER_AUTH",
					"namespace_id": "1002",
					"simple": { "limit": 600, "period": 60 }
				},
				{
					"name": "CSP_REPORT_RATE_LIMITER",
					"namespace_id": "1003",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "RESEND_WEBHOOK_RATE_LIMITER",
					"namespace_id": "1004",
					"simple": { "limit": 120, "period": 60 }
				}
			],
			"vars": {
				"CLOUDFLARE_ENV": "dev"
			}
		},
		"staging": {
			"name": "auditmos-lp-staging",
			"ratelimits": [
				{
					"name": "MCP_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 120, "period": 60 }
				},
				{
					"name": "MCP_RATE_LIMITER_AUTH",
					"namespace_id": "1002",
					"simple": { "limit": 600, "period": 60 }
				},
				{
					"name": "CSP_REPORT_RATE_LIMITER",
					"namespace_id": "1003",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "RESEND_WEBHOOK_RATE_LIMITER",
					"namespace_id": "1004",
					"simple": { "limit": 120, "period": 60 }
				}
			],
			"routes": [{ "pattern": "staging.auditmos.com", "custom_domain": true }],
			"vars": {
				"CLOUDFLARE_ENV": "staging"
			}
		},
		"production": {
			"name": "auditmos-lp-production",
			"ratelimits": [
				{
					"name": "MCP_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 120, "period": 60 }
				},
				{
					"name": "MCP_RATE_LIMITER_AUTH",
					"namespace_id": "1002",
					"simple": { "limit": 600, "period": 60 }
				},
				{
					"name": "CSP_REPORT_RATE_LIMITER",
					"namespace_id": "1003",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "RESEND_WEBHOOK_RATE_LIMITER",
					"namespace_id": "1004",
					"simple": { "limit": 120, "period": 60 }
				}
			],
			"routes": [{ "pattern": "auditmos.com", "custom_domain": true }],
			"vars": {
				"CLOUDFLARE_ENV": "production"
			}
		}
	}
	// Uncomment to enable scheduled jobs:
	// "triggers": { "crons": ["0 * * * *"] },
	// Uncomment to bind a KV namespace:
	// "kv_namespaces": [{ "binding": "CACHE", "id": "" }],
	// Uncomment to bind a queue:
	// "queues": { "producers": [{ "binding": "QUEUE", "queue": "my-queue" }] }
}
