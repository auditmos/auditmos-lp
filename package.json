{
	"name": "auditmos-lp",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"prepare": "simple-git-hooks && wrangler types && pnpm run oss:refresh",
		"init-project": "tsx scripts/init-project.ts",
		"new-project": "tsx scripts/new-project.ts",
		"import-article": "tsx scripts/import-article.ts",
		"dev": "astro dev --port 3000",
		"oss:refresh": "tsx scripts/refresh-oss-cache.ts",
		"build": "pnpm run oss:refresh && pnpm run audits:refresh && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:staging": "tsx scripts/deploy.ts staging",
		"deploy:production": "tsx scripts/deploy.ts production",
		"secrets:staging": "tsx scripts/push-secrets.ts staging",
		"secrets:production": "tsx scripts/push-secrets.ts production",
		"cf-typegen": "wrangler types",
		"agents:verify": "tsx scripts/agents-verify.ts",
		"deploy:mta-sts": "wrangler deploy -c workers/mta-sts/wrangler.jsonc",
		"mta-sts:verify": "tsx scripts/mta-sts-verify.ts",
		"security:gates": "tsx scripts/security-gates.ts",
		"csp:violations": "tsx scripts/csp-violations.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"types": "astro check && tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"knip": "knip",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"deps": "taze -r",
		"deps:update": "taze -r -w",
		"deps:major": "taze -r major",
		"deps:major:update": "taze -r major -w",
		"audits:refresh": "tsx scripts/refresh-audits-cache.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.5",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "2.4.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^4.1.11",
		"execa": "^9.6.1",
		"knip": "^6.39.0",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.14.0",
		"taze": "^19.17.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.147.0",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"vite": "^8.3.1"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run types && pnpm run knip"
	}
}
