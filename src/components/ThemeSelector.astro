<label class="sr-only" for="theme-select">Theme</label>
<select
	id="theme-select"
	class="min-h-11 w-20 cursor-pointer border border-neutral-700 bg-neutral-950 px-2 font-mono text-neutral-300 text-xs sm:w-24 sm:px-3"
	data-theme-select
>
	<option value="system" selected>System</option>
	<option value="light">Light</option>
	<option value="dark">Dark</option>
</select>
