---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import {
	getClientDisplay,
	getProjectProvenanceLabel,
	PROJECT_CAPABILITY_OPTIONS,
	sortProjects,
} from "@/projects";
import { projectsIndexPage } from "@/site/pages";

export const prerender = true;

const projects = sortProjects(await getCollection("projects"));
const capabilityFilters = [{ value: "all", label: "All" }, ...PROJECT_CAPABILITY_OPTIONS] as const;
const capabilityLabels = new Map(
	PROJECT_CAPABILITY_OPTIONS.map((capability) => [capability.value, capability.label]),
);
---

<Layout
	title={projectsIndexPage.title}
	description={projectsIndexPage.description}
	path={projectsIndexPage.path}
>
	<main>
		<section class="border-neutral-800 border-b">
			<div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:py-28">
				<div>
					<p class="eyebrow text-brand-ink">Selected work</p>
					<h1 class="mt-7 max-w-5xl text-balance font-semibold text-5xl text-neutral-50 leading-[1.03] sm:text-7xl">
						Work shown with enough context to judge the fit.
					</h1>
				</div>
				<p class="max-w-xl text-pretty text-lg text-neutral-300 leading-8">
					Client engagements and internal R&D are labelled explicitly. Confidential work is
					described by sector, problem, and outcome—without dressing up what cannot be disclosed.
				</p>
			</div>
		</section>

		<section data-work-library>
			<div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
				<fieldset class="mb-10">
					<legend class="eyebrow mb-4 text-neutral-500">Filter by capability</legend>
					<div class="flex flex-wrap gap-2">
						{
							capabilityFilters.map((filter, index) => (
								<label class="cursor-pointer">
									<input
										class="peer sr-only"
										type="radio"
										name="work-capability"
										value={filter.value}
										checked={index === 0}
									/>
									<span class="inline-flex min-h-11 items-center border border-neutral-700 px-4 py-2 font-mono text-neutral-300 text-sm peer-checked:border-brand-ink peer-checked:bg-brand-accent peer-checked:text-accent-contrast peer-focus-visible:ring-2 peer-focus-visible:ring-brand-ink peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-neutral-950">
										{filter.label}
									</span>
								</label>
							))
						}
					</div>
				</fieldset>
				<div class="border-neutral-800 border-t">
					{
						projects.map((project, index) => (
							<article
								class="border-neutral-800 border-b"
								data-work-item
								data-capabilities={project.data.capabilities.join(" ")}
							>
								<a
									class="group grid gap-5 py-8 hover:bg-neutral-900/50 sm:px-5 lg:grid-cols-[4rem_0.8fr_1.2fr_auto] lg:items-center"
									href={`/work/${project.data.slug}`}
								>
									<span class="font-mono text-neutral-600 text-xs tabular-nums">{String(index + 1).padStart(2, "0")}</span>
									<div>
										<div class="flex flex-wrap items-center gap-2 font-mono text-xs">
											<span class="border border-neutral-700 px-2 py-1 text-neutral-300">{getProjectProvenanceLabel(project.data)}</span>
											{project.data.year && <span class="text-neutral-500 tabular-nums">{project.data.year}</span>}
										</div>
										<p class="mt-3 font-mono text-neutral-500 text-xs">
											{project.data.provenance === "internal-r-and-d" ? project.data.industry : getClientDisplay(project.data)}
										</p>
										<h2 class="mt-3 text-balance font-semibold text-2xl text-neutral-50">{project.data.title}</h2>
									</div>
									<div>
										<p class="max-w-xl text-pretty text-neutral-400 leading-7">{project.data.summary}</p>
										<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 font-mono text-neutral-500 text-xs">
											{project.data.capabilities.map((capability) => <li>{capabilityLabels.get(capability)}</li>)}
										</ul>
									</div>
									<span class="text-brand-ink text-xl transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
								</a>
							</article>
						))
					}
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	[data-work-library]:has(input[value="software"]:checked)
		[data-work-item]:not([data-capabilities~="software"]),
	[data-work-library]:has(input[value="security"]:checked)
		[data-work-item]:not([data-capabilities~="security"]),
	[data-work-library]:has(input[value="applied-r-and-d"]:checked)
		[data-work-item]:not([data-capabilities~="applied-r-and-d"]) {
		display: none;
	}
</style>
