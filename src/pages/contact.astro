---
import Layout from "@/layouts/Layout.astro";
import { contactPage } from "@/site/pages";

export const prerender = true;

const turnstileSiteKey =
	import.meta.env.TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA";
---

<Layout title={contactPage.title} description={contactPage.description} path={contactPage.path}>
	<main>
		<section>
			<div class="mx-auto grid max-w-7xl lg:grid-cols-[0.85fr_1.15fr]">
				<div class="px-5 py-16 sm:px-8 sm:py-24 lg:border-neutral-800 lg:border-r lg:py-28">
					<p class="eyebrow text-brand-ink">Start a conversation</p>
					<h1 class="mt-7 max-w-3xl text-balance font-semibold text-5xl text-neutral-50 leading-[1.03] sm:text-7xl">
						What needs to be built, tested, or made clear?
					</h1>
					<p class="mt-8 max-w-2xl text-pretty text-lg text-neutral-300 leading-8">
						A useful first message names the system or idea, the decision in front of you, and
						any timing or constraints already known.
					</p>
					<div class="mt-10 border-neutral-800 border-t pt-6">
						<p class="eyebrow text-neutral-500">Prefer email?</p>
						<a class="mt-2 inline-block text-brand-ink hover:text-neutral-50" href="mailto:tom@auditmos.com">tom@auditmos.com ↗</a>
					</div>
				</div>

				<form
					id="contact-form"
					class="grid content-center gap-6 bg-neutral-900/40 px-5 py-12 sm:px-8 sm:py-16 lg:p-12"
					action="/api/contact"
					method="post"
				>
					<div class="mb-2">
						<p class="eyebrow text-brand-ink">Project inquiry</p>
						<h2 class="mt-3 text-balance font-semibold text-2xl text-neutral-50 sm:text-3xl">Tell us just enough to begin.</h2>
					</div>
					<div>
						<label class="block font-medium text-sm text-neutral-50" for="name">Your name</label>
						<input
							class="mt-2 w-full border border-neutral-700 bg-neutral-950 px-4 py-3.5 text-neutral-50 outline-none placeholder:text-neutral-600 focus:border-brand-ink focus:ring-1 focus:ring-brand-ink"
							id="name"
							name="name"
							type="text"
							placeholder="Name or company contact"
							autocomplete="name"
							required
							aria-describedby="name-help"
						/>
						<p id="name-help" class="sr-only">Your name or company contact.</p>
					</div>

					<div>
						<label class="block font-medium text-sm text-neutral-50" for="email">Email</label>
						<input
							class="mt-2 w-full border border-neutral-700 bg-neutral-950 px-4 py-3.5 text-neutral-50 outline-none placeholder:text-neutral-600 focus:border-brand-ink focus:ring-1 focus:ring-brand-ink"
							id="email"
							name="email"
							type="email"
							placeholder="you@company.com"
							autocomplete="email"
							inputmode="email"
							required
							aria-describedby="email-help"
						/>
						<p id="email-help" class="mt-2 text-neutral-500 text-sm">
							Used only to reply to this inquiry.
						</p>
					</div>

					<div>
						<label class="block font-medium text-sm text-neutral-50" for="message">Message</label>
						<textarea
							class="mt-2 min-h-40 w-full resize-y border border-neutral-700 bg-neutral-950 px-4 py-3.5 text-neutral-50 outline-none placeholder:text-neutral-600 focus:border-brand-ink focus:ring-1 focus:ring-brand-ink"
							id="message"
							name="message"
							placeholder="What are you working on, and what needs to become clearer?"
							required
							aria-describedby="message-help"
						></textarea>
						<p id="message-help" class="mt-2 text-neutral-500 text-sm">
							Include scope, timing, and any constraints worth knowing before the first reply.
						</p>
					</div>

					<div>
						<div id="contact-turnstile" data-sitekey={turnstileSiteKey}></div>
						<p id="contact-progress" class="text-neutral-400 text-sm" role="status"></p>
					</div>

					<div
						id="contact-success"
						class="hidden border border-emerald-400/40 bg-emerald-400/10 p-4 text-success-text text-sm leading-6"
						tabindex="-1"
						role="status"
					>
						Message sent. Check your inbox for the confirmation email.
					</div>
					<div
						id="contact-error"
						class="hidden border border-red-400/40 bg-red-400/10 p-4 text-error-text text-sm leading-6"
						tabindex="-1"
						role="alert"
					>
						The message could not be sent. Try again, or email tom@auditmos.com directly.
					</div>

					<button
						id="contact-submit"
						class="corner-cut bg-brand-accent px-5 py-3.5 font-semibold text-accent-contrast hover:bg-white disabled:cursor-not-allowed disabled:opacity-60"
						type="submit"
					>
						Send message
					</button>
					<p class="text-pretty text-neutral-500 text-xs leading-5">
						By sending this form, you agree to the handling described in our <a class="underline hover:text-brand-ink" href="/privacy">privacy notice</a>.
					</p>
				</form>
			</div>
		</section>
	</main>
	<script is:inline>
		const form = document.querySelector("#contact-form");
		const success = document.querySelector("#contact-success");
		const error = document.querySelector("#contact-error");
		const submit = document.querySelector("#contact-submit");
		const widget = document.querySelector("#contact-turnstile");
		const progress = document.querySelector("#contact-progress");
		let widgetReady;
		let receiveToken;

		function prepareTurnstile() {
			widgetReady ??= new Promise((resolve) => {
				const script = document.createElement("script");
				script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
				const timeout = setTimeout(fail, 12_000);
				function fail() {
					clearTimeout(timeout);
					script.remove();
					resolve(null);
				}
				script.onerror = fail;
				script.onload = () => {
					if (!script.isConnected) return;
					try {
						const widgetId = globalThis.turnstile.render(widget, {
							sitekey: widget.dataset.sitekey,
							callback: (token) => receiveToken?.(token),
						});
						if (!widgetId) return fail();
						clearTimeout(timeout);
						resolve(widgetId);
					} catch {
						fail();
					}
				};
				document.head.append(script);
			}).then((widgetId) => {
				if (!widgetId) widgetReady = undefined;
				return widgetId;
			});
			return widgetReady;
		}

		function waitForToken(widgetId) {
			const existing = globalThis.turnstile.getResponse(widgetId);
			if (existing && !globalThis.turnstile.isExpired(widgetId)) return existing;
			return new Promise((resolve) => {
				const timeout = setTimeout(() => finish(null), 60_000);
				function finish(token) {
					clearTimeout(timeout);
					receiveToken = undefined;
					resolve(token);
				}
				receiveToken = finish;
			});
		}

		form.addEventListener("focusin", (event) => {
			if (event.target.matches("input, textarea")) prepareTurnstile();
		});

		function showNotice(target, message) {
			success.classList.add("hidden");
			error.classList.add("hidden");
			target.textContent = message;
			target.classList.remove("hidden");
			target.focus();
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (submit.disabled) return;
			success.classList.add("hidden");
			error.classList.add("hidden");
			submit.disabled = true;
			progress.textContent = "Waiting for anti-spam verification…";

			const formData = new FormData(form);
			let widgetId;

			try {
				widgetId = await prepareTurnstile();
				const turnstileToken = widgetId && (await waitForToken(widgetId));
				if (!turnstileToken) {
					showNotice(error, "Anti-spam verification could not complete. Try again, or email tom@auditmos.com directly.");
					return;
				}

				progress.textContent = "Sending message…";
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						name: formData.get("name"),
						email: formData.get("email"),
						message: formData.get("message"),
						turnstileToken,
					}),
				});
				const body = await response.json().catch(() => ({}));

				if (response.ok) {
					form.reset();
					showNotice(success, "Message sent. Check your inbox for the confirmation email.");
					return;
				}

				showNotice(
					error,
					body.error ?? "The message could not be sent. Try again, or email tom@auditmos.com directly.",
				);
			} catch {
				showNotice(error, "Network error. Try again, or email tom@auditmos.com directly.");
			} finally {
				progress.textContent = "";
				submit.disabled = false;
				if (widgetId) globalThis.turnstile.reset(widgetId);
			}
		});
	</script>
</Layout>
